    "import time\n",
    "\n",
    "def predict(model, data, threshold):\n",
    "    start_time = time.time()\n",
    "    reconstructions = model(data)\n",
    "    loss = tf.keras.losses.mae(reconstructions, data)\n",
    "    # Detects if value greater than threshold then return true (for suspicious) else false (not suspicious)\n",
    "    preds = tf.math.greater(loss, threshold)\n",
    "    end_time = time.time()\n",
    "    inference_time = end_time - start_time\n",
    "    return loss.numpy(), preds.numpy().astype(int), inference_time\n",
    "\n",
    "def predict_nce(model, data, threshold=None, alpha=0.5):\n",
    "    \"\"\"\n",
    "    Predict anomaly scores for a model with reconstruction + NCE classifier.\n",
    "\n",
    "    Parameters:\n",
    "        model : tf.keras.Model\n",
    "            The trained NCE autoencoder model.\n",
    "        data : np.ndarray or tf.Tensor\n",
    "            Input data to score.\n",
    "        threshold : float, optional\n",
    "            If given, used to convert anomaly scores to binary predictions.\n",
    "            If None, returns raw anomaly scores.\n",
    "        alpha : float\n",
    "            Weight between reconstruction error and classifier anomaly score.\n",
    "\n",
    "    Returns:\n",
    "        anomaly_scores : np.ndarray\n",
    "            Combined anomaly score per sample.\n",
    "        predictions : np.ndarray\n",
    "            Binary predictions (0=normal, 1=anomaly). Only returned if threshold is set.\n",
    "        inference_time : float\n",
    "            Total time taken to run prediction.\n",
    "    \"\"\"\n",
    "    start_time = time.time()\n",
    "\n",
    "    # Forward pass\n",
    "    reconstructions, classifier_probs = model(data, training=False)\n",
    "\n",
    "    # Reconstruction error per sample\n",
    "    recon_error = np.mean(np.abs(reconstructions - data), axis=1)\n",
    "\n",
    "    # Classifier score -> anomaly score (high = more anomalous)\n",
    "    classifier_score = 1 - classifier_probs.numpy().flatten()\n",
    "\n",
    "    # Combined anomaly score\n",
    "    anomaly_scores = alpha * recon_error + (1 - alpha) * classifier_score\n",
    "\n",
    "    predictions = None\n",
    "    if threshold is not None:\n",
    "        predictions = (anomaly_scores > threshold).astype(int)\n",
    "\n",
    "    end_time = time.time()\n",
    "    inference_time = end_time - start_time\n",
    "\n",
    "    if predictions is not None:\n",
    "        return anomaly_scores, predictions, inference_time\n",
    "    else:\n",
    "        return anomaly_scores, inference_time"
   ]
