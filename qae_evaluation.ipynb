   "source": [
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score,\n",
    "    confusion_matrix, classification_report, roc_auc_score\n",
    ")\n",
    "import numpy as np\n",
    "import tensorflow as tf\n",
    "from keras import layers\n",
    "import pandas as pd\n",
    "\n",
    "def evaluate_model(y_true, y_pred, scores, time, threshold=0.2, model_name=\"Model\"):\n",
    "    \"\"\"\n",
    "    Evaluates a model and returns metrics formatted for copy-pasting.\n",
    "    \n",
    "    Parameters:\n",
    "        y_true (np.array): Ground truth labels (0=normal, 1=anomaly).\n",
    "        scores (np.array): Anomaly scores (lower = more anomalous).\n",
    "        threshold (float): Threshold for anomaly decision.\n",
    "        model_name (str): Name of the model.\n",
    "        \n",
    "    Returns:\n",
    "        dict: Dictionary of metrics (can print or format for LaTeX).\n",
    "    \"\"\"\n",
    "\n",
    "    precision = precision_score(y_true, y_pred, zero_division=0)\n",
    "    accuracy = accuracy_score(y_true, y_pred)\n",
    "    recall = recall_score(y_true, y_pred, zero_division=0)\n",
    "    f1 = f1_score(y_true, y_pred, zero_division=0)\n",
    "    auroc = roc_auc_score(y_true, scores)\n",
    "\n",
    "    cm = confusion_matrix(y_true, y_pred)\n",
    "    clf_report = classification_report(y_true, y_pred, digits=2)\n",
    "\n",
    "    result = {\n",
    "        \"Model\": model_name,\n",
    "        \"Precision\": f\"{precision:.3f}\",\n",
    "        \"Accuracy\": f\"{accuracy:.3f}\",\n",
    "        \"Recall\": f\"{recall:.3f}\",\n",
    "        \"F1-Score\": f\"{f1:.3f}\",\n",
    "        \"Matrix\": f\"TP={cm[1,1]}, FP={cm[0,1]}, FN={cm[1,0]}, TN={cm[0,0]}\",\n",
    "        \"AUROC\": f\"{auroc:.3f}\",\n",
    "        \"Data Loading + Inference Time (s)\": f\"{time:.4f}s\",\n",
    "        \"Clf Report\": clf_report.strip()\n",
    "    }\n",
    "\n",
    "    return result\n"
   ]
  },
