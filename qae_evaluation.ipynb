    "from tqdm import tqdm\n",
    "\n",
    "def compute_anomaly_scores(ae, qnn, input_data, trained_params, encoding_fn, batch_size=64):\n",
    "    scores = []\n",
    "    total_qubits = num_latent + 2 * num_trash + 1\n",
    "    num_encoding_qubits = num_latent + num_trash\n",
    "\n",
    "    ae = ae.assign_parameters({p: v for p, v in zip(ae.parameters, trained_params)})\n",
    "\n",
    "    start = time.time()\n",
    "    for i in tqdm(range(0, len(input_data), batch_size), desc=\"Running inference\"):\n",
    "        batch = input_data[i : i + batch_size]\n",
    "        circuits = []\n",
    "\n",
    "        for x in batch:\n",
    "            qc = QuantumCircuit(total_qubits, 1)\n",
    "\n",
    "            # 1. Slice input based on encoding type\n",
    "            # if encoding_fn == amplitude_encoding:\n",
    "            #     input_slice = x[:2 ** num_encoding_qubits]\n",
    "            # elif encoding_fn == dense_angle_encoding:\n",
    "            #     input_slice = x[:2 * num_encoding_qubits]\n",
    "            # elif encoding_fn == efficient_su2_encoding:\n",
    "            #     input_slice = x[:4 * num_encoding_qubits]\n",
    "            # else:\n",
    "            #     input_slice = x[:num_encoding_qubits]\n",
    "            selection_mode = \"first\"\n",
    "        \n",
    "            if encoding_fn == amplitude_encoding:\n",
    "                N = 2 ** num_encoding_qubits\n",
    "            elif encoding_fn == dense_angle_encoding:\n",
    "                N = 2 * num_encoding_qubits\n",
    "            elif encoding_fn == efficient_su2_encoding:\n",
    "                N = 4 * num_encoding_qubits\n",
    "            else:\n",
    "                N = num_encoding_qubits\n",
    "            \n",
    "            if selection_mode == \"first\":\n",
    "                input_slice = x[:N]\n",
    "            elif selection_mode == \"last\":\n",
    "                input_slice = x[-N:]\n",
    "            elif selection_mode == \"middle\":\n",
    "                start = (len(x) - N) // 2\n",
    "                input_slice = x[start:start + N]\n",
    "            elif selection_mode == \"random\":\n",
    "                idx = np.random.choice(len(x), N, replace=False)\n",
    "                input_slice = x[idx]\n",
    "\n",
    "            # 2. Encode input\n",
    "            encoded = encoding_fn(input_slice)\n",
    "            qc.compose(encoded, qubits=range(encoded.num_qubits), inplace=True)\n",
    "\n",
    "            # 3. Add trained AE circuit\n",
    "            qc.compose(ae, inplace=True)\n",
    "\n",
    "            circuits.append(qc)\n",
    "\n",
    "        # 4. Run sampler\n",
    "        job = qnn.sampler.run(circuits)\n",
    "        result = job.result()\n",
    "\n",
    "        # 5. Extract p(1) as anomaly score\n",
    "        for quasi in result.quasi_dists:\n",
    "            p1 = quasi.get(1, 0)\n",
    "            scores.append(p1)\n",
    "\n",
    "    elapsed = time.time() - start\n",
    "    print(f\"\\nAll batches processed in {elapsed:.4f} seconds.\")\n",
    "\n",
    "    return np.array(scores), elapsed\n",
    "\n"
   ]
