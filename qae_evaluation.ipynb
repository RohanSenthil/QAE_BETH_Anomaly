    "\n",
    "# Constants\n",
    "num_latent = 2\n",
    "num_trash = 2\n",
    "total_qubits = num_latent + 2 * num_trash + 1  # encoding + reference + auxiliary\n",
    "\n",
    "# Step 2: Dummy base circuit (will be composed with encoding later)\n",
    "# Needed just for QNN init. Actual data circuits will be composed separately.\n",
    "dummy_encoding = QuantumCircuit(total_qubits)\n",
    "qc_full = dummy_encoding.compose(ae)\n",
