    "def angle_encoding(x):\n",
    "    num_qubits = len(x)\n",
    "    circuit = QuantumCircuit(num_qubits)\n",
    "    for i in range(num_qubits):\n",
    "        circuit.ry(x[i], i)\n",
    "    return circuit\n",
    "\n",
    "def dense_angle_encoding(x):\n",
    "    num_qubits = len(x) // 2\n",
    "    circuit = QuantumCircuit(num_qubits)\n",
    "    for i in range(num_qubits):\n",
    "        circuit.ry(x[2 * i], i)\n",
    "        circuit.rz(x[2 * i + 1], i)\n",
    "    return circuit\n",
    "\n",
    "def efficient_su2_encoding(x):\n",
    "    num_qubits = int(np.ceil(len(x) / 4))  # EfficientSU2 expects 4 params per qubit per rep\n",
    "    su2 = EfficientSU2(num_qubits=num_qubits, reps=1)\n",
    "\n",
    "    # Pad x to match the number of parameters in EfficientSU2\n",
    "    total_params = su2.num_parameters\n",
    "    padded_x = np.pad(x, (0, total_params - len(x)), mode='constant')\n",
    "\n",
    "    circuit = QuantumCircuit(num_qubits)\n",
    "    circuit.compose(su2.assign_parameters(padded_x), inplace=True)\n",
    "    return circuit\n",
    "\n",
    "def amplitude_encoding(x):\n",
    "\n",
    "    x = np.asarray(x, dtype=np.float64)\n",
    "\n",
    "    # Replace NaNs and Infs with 0 BEFORE padding\n",
    "    if not np.all(np.isfinite(x)):\n",
    "        x = np.nan_to_num(x, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "\n",
    "    # Pad first\n",
    "    num_qubits = int(np.ceil(np.log2(len(x))))\n",
    "    target_len = 2 ** num_qubits\n",
    "    padded = np.pad(x, (0, target_len - len(x))).astype(np.float64)\n",
    "\n",
    "    # Normalize\n",
    "    norm = np.linalg.norm(padded)\n",
    "    if norm == 0 or not np.isfinite(norm):\n",
    "        # Default to |0⟩ state if invalid\n",
    "        normalized = np.zeros_like(padded)\n",
    "        normalized[0] = 1.0\n",
    "    else:\n",
    "        normalized = padded / norm\n",
    "\n",
    "    # Safety check (this ensures Qiskit won't throw)\n",
    "    assert np.isclose(np.sum(normalized**2), 1.0, atol=1e-10), f\"Vector not normalized: {np.sum(normalized**2)}\"\n",
    "\n",
    "    # Create circuit\n",
    "    circuit = QuantumCircuit(num_qubits)\n",
    "    circuit.initialize(normalized, range(num_qubits))\n",
    "    return circuit\n",
    "\n",
    "\n",
    "def build_encoded_circuits(data, encoding_fn):\n",
    "    circuits = []\n",
    "    for x in data:\n",
    "        circuit = encoding_fn(x)\n",
    "        circuits.append(circuit)\n",
    "    return circuits"
   ]
